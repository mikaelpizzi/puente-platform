OTEL_RESOURCE_ATTRIBUTES=service.name=puente-gateway,service.namespace=puente,deployment.environment=production
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic MTQ1NDU3NDpnbGNfZXlKdklqb2lNVFl3TkRNd09TSXNJbTRpT2lKdVpYY3RkRzlyWlc0aUxDSnJJam9pVDJKVVJrZzJWV1oyV0RsdFlVRXdNek0xTmpRM1Z6VllJaXdpYlNJNmV5SnlJam9pY0hKdlpDMTFjeTFsWVhOMExUQWlmWDA9
OTEL_NODE_RESOURCE_DETECTORS=env,host,os

# -----------------------------------------------------------------------------
# SEGURIDAD
# -----------------------------------------------------------------------------
ENABLE_FAKE_PROVIDERS=false
SEED_DEMO_DATA=false
