VITE_VAPID_PUBLIC_KEY=BLnBZwEBfL-5EJueUqmy7bPlo5eoihhkqvfs_9N0KHz1PfgdvgHcSuFPyd2Utm-LUua0IlfcuM9ebzISkzV4wEU

