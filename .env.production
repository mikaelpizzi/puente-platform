###############################################################################
# PUENTE PLATFORM - PRODUCTION ENVIRONMENT
# 
# INSTRUCCIONES:
# 1. Copia este archivo a .env en tu hosting
# 2. Reemplaza todos los valores marcados con [REEMPLAZAR]
# 3. Genera secretos seguros con: openssl rand -base64 32
###############################################################################

NODE_ENV=production
LOG_LEVEL=info
TIMEZONE=America/Lima

# -----------------------------------------------------------------------------
# BASES DE DATOS (usar servicios cloud gratuitos)
# -----------------------------------------------------------------------------

# PostgreSQL - Supabase (https://supabase.com) o Neon (https://neon.tech)
POSTGRES_USER=[REEMPLAZAR]
POSTGRES_PASSWORD=[REEMPLAZAR]
POSTGRES_DB=puente
POSTGRES_HOST=[REEMPLAZAR].supabase.co
POSTGRES_PORT=5432

# MongoDB - Atlas (https://mongodb.com/atlas) tier M0 gratis
MONGO_ROOT_USER=[REEMPLAZAR]
MONGO_ROOT_PASSWORD=[REEMPLAZAR]
MONGO_PORT=27017

# Redis - Upstash (https://upstash.com) tier gratis
REDIS_URL=redis://default:[REEMPLAZAR]@[REEMPLAZAR].upstash.io:6379

# -----------------------------------------------------------------------------
# URLS DE PRODUCCION
# Reemplaza con tu dominio real (ej: puente.vercel.app)
# -----------------------------------------------------------------------------
APP_URL=https://[TU-DOMINIO]
VITE_API_GATEWAY_URL=https://api.[TU-DOMINIO]

# -----------------------------------------------------------------------------
# API GATEWAY
# -----------------------------------------------------------------------------
API_GATEWAY_PORT=3000
API_GATEWAY_ALLOWED_ORIGINS=https://[TU-DOMINIO]
API_GATEWAY_BASE_URL=https://api.[TU-DOMINIO]
AUTH_SERVICE_URL=http://auth-service:3001
PRODUCTS_SERVICE_URL=http://products-service:3002
FINANCE_SERVICE_URL=http://finance-service:3003
LOGISTICS_SERVICE_URL=http://logistics-service:3004
NOTIFICATION_SERVICE_URL=http://notification-service:3006
API_GATEWAY_RATE_LIMIT_WINDOW_MS=60000
API_GATEWAY_RATE_LIMIT_MAX=60

# -----------------------------------------------------------------------------
# SECRETOS - GENERAR CON: openssl rand -base64 32
# -----------------------------------------------------------------------------
JWT_SECRET=[GENERAR-SECRETO-32-CHARS]
GATEWAY_SHARED_SECRET=[GENERAR-SECRETO-32-CHARS]
AUTH_JWT_ACCESS_SECRET=[GENERAR-SECRETO-32-CHARS]
AUTH_JWT_REFRESH_SECRET=[GENERAR-SECRETO-32-CHARS]

# -----------------------------------------------------------------------------
# AUTH SERVICE
# -----------------------------------------------------------------------------
AUTH_SERVICE_PORT=3001
AUTH_DATABASE_URL=postgres://[USER]:[PASS]@[HOST]:5432/puente?schema=auth
AUTH_JWT_TTL=15m
AUTH_REFRESH_TTL=7d
AUTH_ARGON2_MEMORY=19456
AUTH_ARGON2_ITERATIONS=2
AUTH_ARGON2_PARALLELISM=1
APP_NAME=Puente

# -----------------------------------------------------------------------------
# PRODUCTS SERVICE
# -----------------------------------------------------------------------------
PRODUCTS_SERVICE_PORT=3002
PRODUCTS_MONGO_DB=products
PRODUCTS_MONGO_URI=mongodb+srv://[USER]:[PASS]@[CLUSTER].mongodb.net/products?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# CLOUDINARY (ya tienes cuenta - mantener valores)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=drnrbxppy
CLOUDINARY_API_KEY=277412132131816
CLOUDINARY_API_SECRET=c3xEFAbvEpKbbRIiDx0S4gvcy00
VITE_CLOUDINARY_CLOUD_NAME=drnrbxppy

# -----------------------------------------------------------------------------
# MEILISEARCH - Opcion 1: Meilisearch Cloud (https://cloud.meilisearch.com)
# Opcion 2: Deshabilitar y usar busqueda basica de MongoDB
# -----------------------------------------------------------------------------
MEILISEARCH_HOST=https://[TU-INSTANCIA].meilisearch.io
MEILISEARCH_API_KEY=[TU-API-KEY-MEILISEARCH]

# -----------------------------------------------------------------------------
# FINANCE SERVICE
# -----------------------------------------------------------------------------
FINANCE_SERVICE_PORT=3003
FINANCE_DATABASE_URL=postgres://[USER]:[PASS]@[HOST]:5432/puente?schema=finance
FINANCE_LEDGER_BASE_CURRENCY=PEN
RATES_CACHE_TTL_SECONDS=60

# MercadoPago (https://mercadopago.com.ve/developers)
MERCADOPAGO_ACCESS_TOKEN=[TU-ACCESS-TOKEN-MERCADOPAGO]
MERCADOPAGO_WEBHOOK_SECRET=[TU-WEBHOOK-SECRET]

# Binance P2P (opcional)
BINANCE_P2P_API_KEY=[TU-API-KEY]
BINANCE_P2P_API_SECRET=[TU-API-SECRET]
BINANCE_P2P_MERCHANT_ID=[TU-MERCHANT-ID]

# Payment redirects
PAYMENT_SUCCESS_URL=https://[TU-DOMINIO]/payment/success
PAYMENT_FAILURE_URL=https://[TU-DOMINIO]/payment/failure
PAYMENT_PENDING_URL=https://[TU-DOMINIO]/payment/pending

# -----------------------------------------------------------------------------
# LOGISTICS SERVICE
# -----------------------------------------------------------------------------
LOGISTICS_SERVICE_PORT=3004
LOGISTICS_VALKEY_URL=redis://default:[PASS]@[HOST].upstash.io:6379
LOGISTICS_CHANNEL_ASSIGNMENTS=logistics.assignments
LOGISTICS_GEO_KEY=logistics:couriers

# -----------------------------------------------------------------------------
# OSRM - En produccion usar API publica o fallback Haversine
# El fallback ya esta implementado en el codigo
# -----------------------------------------------------------------------------
OSRM_API_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# NOTIFICATION SERVICE
# -----------------------------------------------------------------------------
NOTIFICATION_SERVICE_PORT=3006

# Gmail SMTP (generar App Password en https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mikaelangelopizzi@gmail.com
SMTP_PASS=[TU-APP-PASSWORD-16-CHARS]
SMTP_FROM=mikaelangelopizzi@gmail.com

