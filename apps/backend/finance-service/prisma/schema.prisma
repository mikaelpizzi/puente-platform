generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("FINANCE_DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  FAILED
}

model Order {
  id          String      @id @default(uuid())
  sellerId    String
  buyerId     String?
  totalAmount Decimal
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  sagaId      String?
  
  items       OrderItem[]
  commission  Commission?
  ledgerEntries LedgerEntry[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  quantity  Int
  price     Decimal
}

model Commission {
  id        String   @id @default(uuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  amount    Decimal
  rate      Decimal
  createdAt DateTime @default(now())
}

enum LedgerType {
  CREDIT
  DEBIT
}

enum LedgerCategory {
  SALE
  COMMISSION
  PAYOUT
  REFUND
  ADJUSTMENT
  PLATFORM_FEE  // Platform commission income
  ESCROW_HOLD   // Escrow frozen funds
  ESCROW_RELEASE // Escrow released funds
}

model LedgerEntry {
  id          String         @id @default(uuid())
  userId      String
  amount      Decimal
  type        LedgerType
  category    LedgerCategory
  description String?
  orderId     String?
  order       Order?         @relation(fields: [orderId], references: [id])
  createdAt   DateTime       @default(now())
  referenceId String?
}

// Configurable Commission Rules
model CommissionRule {
  id          String   @id @default(uuid())
  name        String
  description String?
  
  // Targeting
  category    String?  // Product category (vertical)
  campaignId  String?  // Campaign/promo identifier
  sellerId    String?  // Specific seller override
  
  // Rate configuration
  rate        Decimal  // Percentage (e.g., 0.15 = 15%)
  minAmount   Decimal  @default(0) // Minimum commission amount
  maxAmount   Decimal? // Optional max commission cap
  
  // Status
  isActive    Boolean  @default(true)
  priority    Int      @default(0) // Higher = more specific, used first
  
  // Validity period
  validFrom   DateTime @default(now())
  validUntil  DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([priority])
}

// Idempotency Keys for preventing duplicate payments
enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model IdempotencyKey {
  id          String            @id @default(uuid())
  key         String            @unique
  path        String
  method      String
  status      IdempotencyStatus @default(PROCESSING)
  response    String?           @db.Text
  createdAt   DateTime          @default(now())
  completedAt DateTime?
  expiresAt   DateTime

  @@index([expiresAt])
}

// Escrow System for buyer protection
enum EscrowStatus {
  HELD          // Funds frozen after payment
  RELEASED_SELLER // Funds released to seller (order completed)
  RELEASED_BUYER  // Funds refunded to buyer (dispute won)
  DISPUTED       // Dispute opened, awaiting resolution
}

model Escrow {
  id          String       @id @default(uuid())
  orderId     String       @unique
  amount      Decimal
  sellerId    String
  buyerId     String
  status      EscrowStatus @default(HELD)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  releasedAt  DateTime?
  releasedBy  String?      // Admin who released funds
  releaseNote String?

  dispute     Dispute?

  @@index([sellerId])
  @@index([buyerId])
  @@index([status])
}

// Dispute System
enum DisputeStatus {
  OPEN           // Buyer opened dispute
  INVESTIGATING  // Admin reviewing
  RESOLVED_BUYER // Resolved in buyer's favor (refund)
  RESOLVED_SELLER // Resolved in seller's favor (release)
  CLOSED         // Closed without action
}

enum DisputeReason {
  ITEM_NOT_RECEIVED
  ITEM_NOT_AS_DESCRIBED
  ITEM_DAMAGED
  WRONG_ITEM
  QUALITY_ISSUE
  OTHER
}

model Dispute {
  id          String        @id @default(uuid())
  escrowId    String        @unique
  escrow      Escrow        @relation(fields: [escrowId], references: [id])
  orderId     String
  openedBy    String        // Buyer ID
  reason      DisputeReason
  description String        @db.Text
  evidence    String[]      // Array of file URLs
  status      DisputeStatus @default(OPEN)
  
  resolution  String?       @db.Text
  resolvedBy  String?       // Admin ID
  resolvedAt  DateTime?
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
}
