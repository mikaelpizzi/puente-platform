# Production environment variables
# These are embedded at build time by Vite

# Disable socket connections in production until a socket server is available
VITE_ENABLE_SOCKET=false

# API URL - set via hosting provider (Render, Vercel, etc.)
# VITE_API_URL=https://puente-gateway.onrender.com

# WebSocket URL - set via hosting provider when available
# VITE_WS_URL=https://puente-gateway.onrender.com
